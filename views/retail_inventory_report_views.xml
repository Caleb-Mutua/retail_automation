<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Inventory Report List -->
    <record id="view_retail_inventory_report_list" model="ir.ui.view">
        <field name="name">retail.inventory.report.list</field>
        <field name="model">retail.inventory.report</field>
        <field name="arch" type="xml">
            <list string="Inventory Analysis">
                <field name="product_id"/>
                <field name="brand_id"/>
                <field name="quantity"/>
                <field name="min_stock"/>
                <field name="stock_status"/>
                <field name="inventory_value"/>
            </list>
        </field>
    </record>

    <!-- Inventory Report Pivot -->
    <record id="view_retail_inventory_report_pivot" model="ir.ui.view">
        <field name="name">retail.inventory.report.pivot</field>
        <field name="model">retail.inventory.report</field>
        <field name="arch" type="xml">
            <pivot string="Inventory Analysis">

                <field name="brand_id" type="row"/>
                <field name="stock_status" type="col"/>

                <field name="quantity" type="measure"/>
                <field name="min_stock" type="measure"/>
                <field name="inventory_value" type="measure"/>

            </pivot>
        </field>
    </record>

    <!-- Inventory Report Graph -->
    <record id="view_retail_inventory_report_graph" model="ir.ui.view">
        <field name="name">retail.inventory.report.graph</field>
        <field name="model">retail.inventory.report</field>
        <field name="arch" type="xml">
            <graph string="Inventory Overview" type="bar">

                <field name="brand_id"/>
                <field name="quantity" type="measure"/>

            </graph>
        </field>
    </record>
    

    <record id="view_retail_inventory_report_search"
            model="ir.ui.view">
        <field name="name">retail.inventory.report.search</field>
        <field name="model">retail.inventory.report</field>
        <field name="arch" type="xml">
            <search string="Inventory Analysis">
                <field name="product_id"/>
                <field name="brand_id"/>

                <filter name="out_of_stock"
                        string="Out of Stock"
                        domain="[('stock_status', '=', 'out_of_stock')]"/>

                <filter name="low_stock"
                        string="Low Stock"
                        domain="[('stock_status', '=', 'low_stock')]"/>

                <filter name="in_stock"
                        string="In Stock"
                        domain="[('stock_status', '=', 'in_stock')]"/>

                <separator/>

                <group expand="0" string="Group By">
                    <filter name="group_brand"
                            string="Brand"
                            context="{'group_by': 'brand_id'}"/>
                    <filter name="group_status"
                            string="Stock Status"
                            context="{'group_by': 'stock_status'}"/>
                </group>
            </search>
        </field>
    </record>
    <!-- Inventory Report Action -->
    <record id="action_retail_inventory_report"
            model="ir.actions.act_window">

        <field name="name">Inventory Analysis</field>
        <field name="res_model">retail.inventory.report</field>
        <field name="view_mode">pivot,graph,list</field>

        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Analyze your retail inventory.
            </p>

            <p>
                Monitor stock quantities, minimum stock levels,
                stock status and inventory value.
            </p>
        </field>

    </record>

    <!-- Reporting Menu -->
    <menuitem
        id="menu_retail_inventory_analysis"
        name="Inventory Analysis"
        parent="menu_retail_reporting"
        action="action_retail_inventory_report"
        sequence="20"
    />

</odoo>