<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Retail Sales Analysis Pivot -->
    <record id="view_retail_sales_report_pivot" model="ir.ui.view">
        <field name="name">retail.sales.report.pivot</field>
        <field name="model">sale.report</field>
        <field name="arch" type="xml">
            <pivot string="Retail Sales Analysis">
                <field name="date" type="row" interval="month"/>
                <field name="product_id" type="row"/>
                <field name="partner_id" type="col"/>
                <field name="price_subtotal" type="measure"/>
                <field name="product_uom_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Retail Sales Analysis Graph -->
    <record id="view_retail_sales_report_graph" model="ir.ui.view">
        <field name="name">retail.sales.report.graph</field>
        <field name="model">sale.report</field>
        <field name="arch" type="xml">
            <graph string="Retail Sales Trends" type="bar">
                <field name="date" interval="month"/>
                <field name="price_subtotal" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Retail Sales Analysis Action -->
    <record id="action_retail_sales_report"
            model="ir.actions.act_window">
        <field name="name">Sales Analysis</field>
        <field name="res_model">sale.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="view_id" ref="view_retail_sales_report_pivot"/>
        <field name="domain">[('state', 'in', ['sale', 'done'])]</field>
        <field name="context">
            {'search_default_group_by_date': 0}
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Analyze your retail sales.
            </p>
            <p>
                Review sales quantities and revenue by product,
                customer and month.
            </p>
        </field>
    </record>

    <!-- Retail Reporting Menu -->
    <menuitem
        id="menu_retail_reporting"
        name="Reporting"
        parent="menu_retail_management"
        sequence="60"
    />

    <menuitem
        id="menu_retail_sales_analysis"
        name="Sales Analysis"
        parent="menu_retail_reporting"
        action="action_retail_sales_report"
        sequence="10"
    />

</odoo>