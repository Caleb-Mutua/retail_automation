<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_partner_form_retail_customer" model="ir.ui.view">
        <field name="name">res.partner.form.retail.customer</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='category_id']" position="after">

                <field name="customer_status"/>
                <field name="customer_type"/>
                <field name="customer_notes"/>

            </xpath>

        </field>
    </record>

    <record id="view_retail_customer_list" model="ir.ui.view">
        <field name="name">res.partner.list.retail.customer</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list>
               <field name="name"/>
               <field name="phone"/>
               <field name="email"/>
               <field name="customer_type"/>
               <field name="customer_status"/>
            </list>
         </field>
     </record>
     <record id="view_retail_customer_search" model="ir.ui.view">
         <field name="name">res.partner.search.retail.customer</field>
         <field name="model">res.partner</field>
         <field name="arch" type="xml">
            <search>
                 <field name="name"/>
                 <field name="phone"/>
                 <field name="email"/>

               <filter
                   name="active_customers"
                   string="Active"
                   domain="[('customer_status', '=', 'active')]"
               />

               <filter
                   name="inactive_customers"
                   string="Inactive"
                   domain="[('customer_status', '=', 'inactive')]"
               />

             <group string="Group By">
                <filter
                    name="group_customer_type"
                    string="Customer Type"
                    context="{'group_by': 'customer_type'}"
                />

                <filter
                    name="group_customer_status"
                    string="Customer Status"
                    context="{'group_by': 'customer_status'}"
                />
             </group>
            </search>
         </field>
     </record>
     <record id="action_retail_customers" model="ir.actions.act_window">
         <field name="name">Customers</field>
         <field name="res_model">res.partner</field>
         <field name="view_mode">list,form</field>
         <field name="view_id" ref="view_retail_customer_list"/>
         <field name="search_view_id" ref="view_retail_customer_search"/>
         <field name="domain">[('customer_status', '!=', False)]</field>
     </record>

     <!-- Customer Menu -->
     <menuitem
         id="menu_retail_customers"
         name="Customers"
         action="action_retail_customers"
         sequence="20"
     />
</odoo>