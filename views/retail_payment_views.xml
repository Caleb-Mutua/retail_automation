<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Payment List -->
    <record id="view_retail_payment_list" model="ir.ui.view">
        <field name="name">retail.payment.list</field>
        <field name="model">retail.payment</field>
        <field name="arch" type="xml">
            <list
                string="Retail Payments"
                decoration-success="state == 'confirmed'"
                decoration-muted="state == 'cancelled'"
                decoration-warning="state == 'draft'"
            >
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="partner_id"/>
                <field name="payment_date"/>
                <field name="payment_method"/>
                <field name="amount"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Payment Form -->
    <record id="view_retail_payment_form" model="ir.ui.view">
        <field name="name">retail.payment.form</field>
        <field name="model">retail.payment</field>
        <field name="arch" type="xml">
            <form string="Retail Payment">
                <header>
                    <button
                        name="action_confirm"
                        string="Confirm"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_cancel"
                        string="Cancel"
                        type="object"
                        invisible="state != 'confirmed'"
                    />
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,cancelled"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="sale_order_id"
                                   readonly="state != 'draft'"/>
                            <field name="partner_id"/>
                            <field name="payment_date"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="amount"
                                   readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="payment_method"
                                   readonly="state != 'draft'"/>
                            <field name="transaction_reference"
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <group>
                        <field name="notes"
                               readonly="state != 'draft'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Payment Action -->
    <record id="action_retail_payments" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">retail.payment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first retail payment.
            </p>
        </field>
    </record>
    
    <!-- Payments Menu -->
    <menuitem
       id="menu_retail_payments"
       name="Payments"
       parent="menu_retail_management"
       action="action_retail_payments"
       sequence="40"
    />
</odoo>