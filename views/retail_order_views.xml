<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_sale_order_form_retail" model="ir.ui.view">
        <field name="name">sale.order.form.retail.automation</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="retail_order_status" readonly="1"/>
            </xpath>
            <xpath expr="//button[@name='action_confirm']" position="after">

             <button
                    name="action_start_processing"
                    string="Start Processing"
                    type="object"
                    class="btn-primary"
                    invisible="retail_order_status != 'confirmed'"
             />
             <button
                    name="action_mark_ready"
                    string="Mark Ready"
                    type="object"
                    class="btn-primary"
                    invisible="retail_order_status != 'processing'"
             />
            
             
             <button
                    name= "action_view_delivery"
                    string= "View Delivery"
                    type= "object"
                    class="btn-necessary"
                    invisible="state not in ('sale', 'done')"
            />
            </xpath>  
          <notebook>
                  <!-- Your existing pages -->

                <page string="Payments">
                    <group>
                        <group>
                            <field name="retail_payment_status"
                                   widget="badge"/>

                            <field name="retail_amount_paid"/>
                            <field name="retail_balance"/>
                       </group>
                   </group>

                   <field name="payment_ids">
                   <list>
                       <field name="name"/>
                       <field name="payment_date"/>
                       <field name="payment_method"/>
                       <field name="transaction_reference"/>
                       <field name="amount"/>
                       <field name="state" widget="badge"/>
                   </list>
                   </field>
                </page>
                <page string="Deliveries">
                    <field name="picking_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="scheduled_date" string="Scheduled Date"/>
                            <field name="date_done" string="Delivery date"/>
                            <field name="picking_type_id" string="operation"/>
                            <field name="state" string="status" widget="badge"/>
                        </list>
                    </field>
                </page>
          </notebook>
        </field>
    </record>

</odoo>